{
  "name": "edumoz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "EDUMOZ_PRODUCTION_BUILD=1 next build",
    "start": "EDUMOZ_PRODUCTION_BUILD=1 next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "typecheck": "tsc --noEmit",
    "db:test:prepare": "tsx scripts/prepare-test-database.ts",
    "db:test:recovery": "tsx scripts/verify-test-recovery.ts",
    "db:test:integrity": "tsx scripts/verify-tenant-migration.ts",
    "db:test:financial-integrity": "tsx scripts/verify-financial-migration.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:permissions": "tsx prisma/seed-permissions.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:test:staff-integrity": "tsx scripts/verify-staff-migration.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.8.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.16",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "^30.0.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
