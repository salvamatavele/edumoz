# Copiar para .env e preencher. Nenhum valor real deve ser versionado.

# Base de dados (MariaDB / MySQL)
DATABASE_URL="mysql://utilizador:palavra_passe@127.0.0.1:3306/edumoz"

# Auth.js — gerar com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Tipo: OAuth client ID > Web application
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Palavra-passe do administrador criado pelo seed. Obrigatória fora de desenvolvimento.
SEED_ADMIN_PASSWORD=""

# Base descartável usada pelo Prisma para calcular migrações.
SHADOW_DATABASE_URL="mysql://utilizador:palavra_passe@127.0.0.1:3306/edumoz_shadow"

# Testes: configurar em .env.test.local, nunca reutilizar a base da aplicação.
# npm run db:test:prepare cria credenciais aleatórias com acesso apenas a edumoz_test.
# TEST_DATABASE_URL="mysql://edumoz_test_runner:segredo@127.0.0.1:3306/edumoz_test"
